ipipeline {
    agent any

    environment {
        REGISTRY = 'ghcr.io/saipappala'
        SERVICE_DIR = 'frontend'
        IMAGE_NAME = "${SERVICE_DIR}"
        TAG = "${BUILD_NUMBER}"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Compile & Test') {
            steps {
                // Change directory to the service folder before building/testing web assets
                dir("${SERVICE_DIR}") {
                    sh '''
                        echo "Validating frontend assets in ${SERVICE_DIR}..."
                        # If using Node/npm package build, uncomment below:
                        # npm install && npm test
                    '''
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                // Point docker build directly to the Dockerfile and context path inside the service folder
                sh "docker build -t ${REGISTRY}/${IMAGE_NAME}:${TAG} -t ${REGISTRY}/${IMAGE_NAME}:latest ./${SERVICE_DIR}"
            }
        }

        stage('Push Image to Registry') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'github-pat-credentials', usernameVariable: 'USER', passwordVariable: 'PASS')]) {
                    sh "echo ${PASS} | docker login ghcr.io -u ${USER} --password-stdin"
                    sh "docker push ${REGISTRY}/${IMAGE_NAME}:${TAG}"
                    sh "docker push ${REGISTRY}/${IMAGE_NAME}:latest"
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
    }
}
