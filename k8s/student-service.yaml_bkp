apiVersion: apps/v1
kind: Deployment
metadata:
  name: student-service
  labels:
    app: student-service
spec:
  replicas: 1
  selector:
    matchLabels:
      app: student-service
  template:
    metadata:
      labels:
        app: student-service
      annotations:
        # Enable Vault Agent Injector
        vault.hashicorp.com/agent-inject: "true"
        vault.hashicorp.com/role: "student-tracker-role" # Your Vault Kubernetes authentication role
        
        # Inject secret from Vault path (e.g., secret/data/database/credentials)
        vault.hashicorp.com/agent-inject-secret-database-config: "secret/data/database/credentials"
        
        # Format the injected file as environment variables
        vault.hashicorp.com/agent-inject-template-database-config: |
          {{- with secret "secret/data/database/credentials" -}}
          export DB_HOST="{{ .Data.data.host }}"
          export DB_PORT="{{ .Data.data.port }}"
          export DB_USER="{{ .Data.data.username }}"
          export DB_PASSWORD="{{ .Data.data.password }}"
          {{- end -}}
    spec:
      containers:
        - name: student-service
          image: ghcr.io/YOUR_GITHUB_USERNAME/student-service:latest
          ports:
            - containerPort: 8081
          # Command wraps the Spring Boot startup to source the injected Vault secret file first
          command: ["/bin/sh", "-c"]
          args:
            - |
              if [ -f /vault/secrets/database-config ]; then
                source /vault/secrets/database-config
              fi
              java -jar app.jar
